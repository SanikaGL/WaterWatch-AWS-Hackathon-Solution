{
  "name": "waterwatch-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:db": "docker run --rm -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "dev": "tsx watch src/local/server.ts",
    "dev:mem": "cross-env USE_MEMORY_DB=true tsx watch src/local/server.ts",
    "setup:db": "tsx src/local/createTable.ts",
    "seed": "tsx src/local/seed.ts",
    "seed:mem": "cross-env USE_MEMORY_DB=true tsx src/local/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.670.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.670.0",
    "@aws-sdk/client-dynamodb": "^3.670.0",
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/lib-dynamodb": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
